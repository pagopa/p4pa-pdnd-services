                  "pm.test(\"PDND - 02_getCitizenData - Responses with 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"MyPay - 02_getCitizenData - check response and reading citizen data\", function () {\r\n    let jsonResponse = pm.response.json();\r\n\r\n    pm.expect(jsonResponse).to.have.property(\"firstName\", \"Norris\");\r\n    pm.expect(jsonResponse).to.have.property(\"lastName\", \"Jones\");\r\n    pm.expect(jsonResponse).to.have.property(\"dateOfBirth\", \"2005-07-28\");\r\n    \r\n    pm.expect(jsonResponse).to.have.property(\"address\");\r\n    pm.expect(jsonResponse.address).to.have.property(\"street\", \"Barabara Passage\");\r\n    pm.expect(jsonResponse.address).to.have.property(\"city\", \"Roma\");\r\n    pm.expect(jsonResponse.address).to.have.property(\"postalCode\", \"00100\");\r\n    pm.expect(jsonResponse.address).to.have.property(\"country\", \"Italia\");\r\n});\r\n"
