        {
          "name": "00_getUserInfo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Auth - getUserInfo - Responses with 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Auth - getUserInfo - Verify response body\", function () {\r\n    let jsonResponse = pm.response.json();\r\n\r\n    pm.expect(jsonResponse).have.property(\"userId\")\r\n    pm.expect(jsonResponse).have.property(\"mappedExternalUserId\")\r\n    pm.expect(jsonResponse).have.property(\"name\")\r\n    pm.expect(jsonResponse).have.property(\"familyName\")\r\n    pm.expect(jsonResponse).have.property(\"fiscalCode\").to.eq(\"DMEMPY15L21L736U\")\r\n    pm.expect(jsonResponse).have.property(\"issuer\").to.eq(pm.environment.get(\"tokenExchange_issuer\"))\r\n    pm.expect(jsonResponse).have.property(\"organizationAccess\")\r\n    pm.expect(jsonResponse).to.have.property(\"brokerId\").that.is.a(\"number\");\r\n    pm.expect(jsonResponse).to.have.property(\"brokerFiscalCode\").that.is.a(\"string\");\r\n    pm.expect(jsonResponse).to.have.property(\"canManageUsers\").that.is.a(\"boolean\");\r\n    \r\n    jsonResponse.organizations.forEach(org => {\r\n        pm.expect(org).have.property(\"operatorId\")\r\n        pm.expect(org).have.property(\"organizationId\").that.is.a(\"number\");\r\n        if(org.organizationIpaCode == \"IPA_TEST_2\"){\r\n            pm.expect(org.roles).have.property(\"length\").to.eq(1)\r\n            pm.expect(org).have.property(\"email\")\r\n            pm.expect(org.roles[0]).to.eq(\"ROLE_ADMIN\")\r\n            pm.collectionVariables.set(\"organizationId\",org.organizationId)\r\n        }\r\n    });\r\n\r\n});"
                ]
              }
            }
          ],
